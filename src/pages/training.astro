---
import BaseLayout from '../layouts/BaseLayout.astro';
import { training } from '../data/training';

// 负荷图
const loadMax = 400;
const weekH = Math.round((training.load.week / loadMax) * 110);
const baseH = Math.round((training.load.baseline / loadMax) * 110);

// ACWR
const acwrScale = 200;
const acwrX = 20 + training.acwr.ratio * acwrScale;

// 恢复：三条横向对比
const recRows = [
  { label: '静息心率', week: training.recovery.rhr.week, ref: training.recovery.rhr.base, min: 40, max: 80, refLabel: '基线', unit: 'bpm' },
  { label: 'HRV', week: training.recovery.hrv.week, ref: training.recovery.hrv.base, min: 20, max: 70, refLabel: '基线', unit: 'ms' },
  { label: '睡眠', week: training.recovery.sleep.week, ref: training.recovery.sleep.target, min: 4, max: 10, refLabel: '目标', unit: 'h' },
];
const recX = (v, min, max) => 70 + ((v - min) / (max - min)) * 240;
const recRowsGeo = recRows.map((row, i) => ({
  ...row,
  y: 34 + i * 46,
  weekX: recX(row.week, row.min, row.max),
  refX: recX(row.ref, row.min, row.max),
}));

// 训练构成 donut
const R = 52;
const C = 2 * Math.PI * R;
let acc = 0;
const donut = training.mix.map((m) => {
  const len = (m.value / training.mixTotal) * C;
  const seg = { ...m, len, offset: acc };
  acc += len;
  return seg;
});

// 跑步技术
const techTargets = [
  { min: 170, max: 175 },
  { min: 6, max: 9 },
  { min: 200, max: 260 },
];
const techX = (v, min, max) => 90 + ((Math.min(Math.max(v, min), max) - min) / (max - min)) * 240;
const techRows = training.technique.map((row, i) => {
  const t = techTargets[i];
  const pct = (row.value - row.min) / (row.max - row.min);
  const markerX = 90 + Math.min(Math.max(pct, 0), 1) * 240;
  return {
    ...row,
    y: 34 + i * 46,
    markerX,
    bandX: techX(t.min, row.min, row.max),
    bandW: techX(t.max, row.min, row.max) - techX(t.min, row.min, row.max),
  };
});

const dayType = (t) => (t === 'run' ? '#d0764f' : t === 'ride' ? '#84a7b2' : '#2b2c27');
---
<BaseLayout title="训练" description="每周训练诊断：负荷、恢复、跑步技术和训练构成。">
  <section class="training-hero shell">
    <div class="eyebrow">训练 / {training.week} · {training.range}</div>
    <h1>把这一周<br />看仔细。</h1>
    <p class="lede">{training.intro}</p>

    <div class="chart-grid">
      <div class="chart-card">
        <h3>训练负荷</h3>
        <p class="chart-note">本周 TRIMP 340，是基线周中位的两倍多。</p>
        <svg class="chart-svg" viewBox="0 0 420 190" role="img" aria-label="本周训练负荷与基线对比">
          <line x1="60" y1="160" x2="380" y2="160" stroke="#2b2c27" stroke-width="1" />
          <rect x="120" y={160 - baseH} width="64" height={baseH} fill="#6f6a5f" />
          <rect x="240" y={160 - weekH} width="64" height={weekH} fill="#d0764f" />
          <text x="152" y={160 - baseH - 8} text-anchor="middle" class="val">{training.load.baseline}</text>
          <text x="272" y={160 - weekH - 8} text-anchor="middle" class="val">{training.load.week}</text>
          <text x="152" y="178" text-anchor="middle">基线周中位</text>
          <text x="272" y="178" text-anchor="middle">本周</text>
          <line x1="60" y1="60" x2="380" y2="60" stroke="#2b2c27" stroke-width="1" stroke-dasharray="3 4" />
          <text x="64" y="56">400</text>
        </svg>
      </div>

      <div class="chart-card">
        <h3>急性 / 慢性负荷比（ACWR）</h3>
        <p class="chart-note">1.55，已经越过 1.3 的负荷突增线，偏向“练猛了”。</p>
        <svg class="chart-svg" viewBox="0 0 420 150" role="img" aria-label="ACWR 比值与风险区间">
          <rect x="20" y="46" width="160" height="22" fill="#24251f" />
          <rect x="180" y="46" width="100" height="22" fill="#3f5f4c" />
          <rect x="280" y="46" width="60" height="22" fill="#6b4a2a" />
          <rect x="340" y="46" width="80" height="22" fill="#5a2320" />
          <line x1={acwrX} y1="38" x2={acwrX} y2="76" stroke="#ece7dc" stroke-width="2" />
          <circle cx={acwrX} cy="38" r="4" fill="#ece7dc" />
          <text x="20" y="94">0</text>
          <text x="180" y="94" text-anchor="middle">0.8</text>
          <text x="280" y="94" text-anchor="middle">1.3</text>
          <text x="400" y="94" text-anchor="end">2.0</text>
          <text x={acwrX} y="118" text-anchor="middle" class="val">1.55</text>
          <text x="20" y="132">偏轻</text>
          <text x="230" y="132" text-anchor="middle">合适区间</text>
          <text x="400" y="132" text-anchor="end">偏高</text>
        </svg>
      </div>

      <div class="chart-card">
        <h3>恢复信号</h3>
        <p class="chart-note">静息心率和 HRV 都在往差的方向走，睡眠离目标还差一截。</p>
        <svg class="chart-svg" viewBox="0 0 400 180" role="img" aria-label="静息心率、HRV 和睡眠与基线对比">
          {recRowsGeo.map((row) => (
            <>
              <text x="0" y={row.y - 4} class="lbl">{row.label}</text>
              <rect x="70" y={row.y - 12} width="240" height="14" fill="#24251f" />
              <rect x="70" y={row.y - 12} width={row.weekX - 70} height="14" fill="#d0764f" />
              <line x1={row.refX} y1={row.y - 18} x2={row.refX} y2={row.y + 6} stroke="#84a7b2" stroke-width="2" />
              <text x="320" y={row.y - 1} class="val">{row.week} {row.unit}</text>
              <text x="70" y={row.y + 20} class="lbl">{row.refLabel} {row.unit === '%' ? '' : row.ref} {row.unit}</text>
            </>
          ))}
        </svg>
      </div>

      <div class="chart-card">
        <h3>这 44 次训练都练了什么</h3>
        <p class="chart-note">力量占了将近一半，跑步和骑行负责有氧。</p>
        <svg class="chart-svg" viewBox="0 0 380 190" role="img" aria-label="训练类型构成">
          <g transform="translate(96,95)">
            <circle r={R} fill="none" stroke="#24251f" stroke-width="20" />
            {donut.map((seg) => (
              <circle
                r={R}
                fill="none"
                stroke={seg.color}
                stroke-width="20"
                stroke-dasharray={seg.len + ' ' + (C - seg.len)}
                stroke-dashoffset={-seg.offset}
                transform="rotate(-90)"
              />
            ))}
            <text x="0" y="2" text-anchor="middle" class="val" style="font-size:16px">{training.mixTotal}</text>
            <text x="0" y="18" text-anchor="middle">次训练</text>
          </g>
          {donut.map((seg, i) => (
            <g>
              <rect x="210" y={44 + i * 34} width="9" height="9" fill={seg.color} />
              <text x="226" y={52 + i * 34} class="lbl">{seg.label}</text>
              <text x="340" y={52 + i * 34} text-anchor="end" class="val">{seg.value}</text>
            </g>
          ))}
        </svg>
      </div>

      <div class="chart-card">
        <h3>跑步技术</h3>
        <p class="chart-note">三项都还差一点点，最该练的是步频。</p>
        <svg class="chart-svg" viewBox="0 0 400 180" role="img" aria-label="步频、垂直振幅比、触地时间与目标区间">
          {techRows.map((row) => (
            <>
              <text x="0" y={row.y - 4} class="lbl">{row.label}</text>
              <rect x="90" y={row.y - 12} width="240" height="14" fill="#24251f" />
              <rect x={row.bandX} y={row.y - 18} width={row.bandW} height="26" fill="none" stroke="#84a7b2" stroke-width="1.5" stroke-dasharray="3 3" />
              <line x1={row.markerX} y1={row.y - 18} x2={row.markerX} y2={row.y + 8} stroke="#d0764f" stroke-width="2.5" />
              <text x="340" y={row.y - 1} class="val">{row.value} {row.unit}</text>
              <text x="90" y={row.y + 22} class="lbl">目标 {row.target}</text>
            </>
          ))}
        </svg>
      </div>

      <div class="chart-card">
        <h3>这一周的节奏</h3>
        <p class="chart-note">两次有氧，一次力量（力量这次没记日期）。</p>
        <svg class="chart-svg" viewBox="0 0 400 150" role="img" aria-label="本周七天训练分布">
          {training.weekDays.map((d, i) => (
            <g>
              <text x={28 + i * 52} y="26" text-anchor="middle" class="lbl">{d.day}</text>
              <text x={28 + i * 52} y="42" text-anchor="middle">{d.date}</text>
              <rect x={10 + i * 52} y="54" width="36" height="36" fill={d.type === 'rest' ? '#121310' : dayType(d.type)} stroke={d.type === 'rest' ? '#2b2c27' : 'none'} />
              <text x={28 + i * 52} y="112" text-anchor="middle" class="lbl">{d.type === 'rest' ? '' : d.label}</text>
            </g>
          ))}
        </svg>
      </div>
    </div>

    <p class="training-note-line">图表来自 2026 W47 的训练诊断。原始数据在本地，这里只放结论和聚合指标。</p>
  </section>

  <div class="training-grid shell">
    <div class="training-prose">
      <h2>教练摘要</h2>
      <ul>
        {training.summary.map((item) => <li>{item}</li>)}
      </ul>

      <h2>本周解剖</h2>
      <ul>
        {training.sessions.map((item) => <li>{item}</li>)}
      </ul>

      <h2>恢复信号</h2>
      <ul>
        {training.recoveryText.map((item) => <li>{item}</li>)}
      </ul>

      <h2>下一阶段</h2>
      <ul>
        {training.next.map((item) => <li>{item}</li>)}
      </ul>

      <h2>基线</h2>
      <p>{training.baseline.map((b) => b.label + '：' + b.value).join('；')}。</p>

      <div class="training-note">{training.disclaimer}</div>
    </div>

    <aside class="training-side">
      <h3>这份报告</h3>
      <dl>
        <dt>周期</dt>
        <dd>{training.week}（{training.range}）</dd>
        <dt>数据来源</dt>
        <dd>{training.source}</dd>
        <dt>更新</dt>
        <dd>{training.updated} · 由 Mac 上的 weekly_report.py 生成快照</dd>
        <dt>公开范围</dt>
        <dd>只有聚合指标，原始健康文件不公开</dd>
      </dl>
      <p><a class="button ghost" href="/projects/training-diagnostic/">这个诊断是怎么做的 <span class="arrow">↗</span></a></p>
    </aside>
  </div>
</BaseLayout>
