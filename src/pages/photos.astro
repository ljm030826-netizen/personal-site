---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { photos, unsplashProfile } from '../data/photos';
---
<BaseLayout title="照片" description="Jiaming Luo 拍的照片：城市、旅途和日常。">
  <header class="shell gallery-heading"><h1>摄影选集</h1><p>Jiaming Luo　/　2023 — 2026</p></header>
  <section class="page-body shell photo-page">
    <PhotoGrid photos={photos} />
    <div class="photo-foot">
      <span>{photos.length} 幅作品</span>
      <a class="button ghost" href={unsplashProfile} target="_blank" rel="noopener">Unsplash <span class="arrow">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>.gallery-heading{padding-block:3rem 2rem;display:flex;align-items:baseline;justify-content:space-between;gap:1em;flex-wrap:wrap}.gallery-heading h1{font:500 clamp(2.4rem,5vw,5rem)/1.2 var(--display)}.gallery-heading p{color:var(--muted)}</style>
