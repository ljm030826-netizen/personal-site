---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { photos } from '../../data/photos';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
const cover = photos.find(photo => photo.href.endsWith('cnRuUMK9EWI'));
---
<BaseLayout title="作品" description="我的训练周报、读手表数据的小程序，还有你正在看的这个网站。">
  <div class="shell notebook">
    <header class="opening">
      <div>
        <h1>自己用的东西</h1>
        <p>手表知道我这周练了几次，至于下周腿还练不练，它没说。于是我给自己写了份周报。写着写着，光是怎么把手表里的数读出来，又够单开一篇了。</p>
      </div>
      {cover && <figure><a href={cover.href}><img src={cover.src} alt={cover.alt} /></a><figcaption>{cover.caption} · {cover.meta}</figcaption></figure>}
    </header>
    <section aria-label="项目目录">
      {projects.map(({id,data}) => <a class="entry" href={'/projects/'+id+'/'}>
        <span class="year">{data.year}</span>
        <div><h2>{data.title}</h2><p>{data.description}</p></div>
        <span class="arrow" aria-hidden="true">→</span>
      </a>)}
    </section>
  </div>
</BaseLayout>
<style>
  .notebook { max-width: 1000px; padding-block: clamp(2rem,7vw,6rem); }
  .opening { display:grid; grid-template-columns: 1.15fr 1fr; gap:clamp(2rem,7vw,6rem); align-items:center; margin-bottom:clamp(2rem,6vw,5rem); }
  h1,h2 {font-family:var(--display);line-height:1.3;}
  h1 {font-size:clamp(2.4rem,5vw,4.4rem);margin-bottom:1.4rem;}
  p {color:var(--muted);margin:0;line-height:1.9;}
  figure {margin:0;} figure img {width:100%;height:auto;}
  figcaption,.year {font: .8rem/1.6 var(--mono);color:var(--muted);}
  figcaption {margin-top:.55rem;}
  .entry {display:grid;grid-template-columns:4rem minmax(0,1fr) auto;gap:1rem;border-top:1px solid var(--line);padding:1.7rem 0;}
  h2 {font-size:clamp(1.45rem,3vw,2rem);margin-bottom:.55rem;}
  .entry p {max-width:37em;}
  .year,.arrow {padding-top:.3rem;}
  .entry:hover h2,.entry:focus-visible h2,.arrow {color:var(--accent);}
  @media(max-width:680px){.opening{grid-template-columns:1fr;gap:1.4rem;} .entry{grid-template-columns:minmax(0,1fr) auto;gap:.45rem;} .year{grid-column:1/-1;} figure img{max-height:42vh;object-fit:contain;object-position:left;}}
</style>
