---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, year, role, stack } = project.data;
---
<BaseLayout title={title} description={description}>
  <article>
    <header class="detail-hero shell">
      <div class="eyebrow">项目 / {year}</div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="detail-meta">
        <span>角色 — {role}</span>
        <span>技术 — {stack.join(' · ')}</span>
      </div>
    </header>
    <div class="detail-body shell">
      <div class="prose"><Content /></div>
      <p style="margin-top:40px"><a class="button ghost" href="/projects/">← 全部作品</a></p>
    </div>
  </article>
</BaseLayout>
