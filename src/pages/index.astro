---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { photos } from '../data/photos';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<BaseLayout>
  <section class="hero-home shell">
    <div class="hero-copy">
      <div class="eyebrow">医学信息学 · 德国海尔布隆</div>
      <h1 class="hero-title">Jiaming<br /><em>Luo.</em></h1>
      <p class="hero-lede">
        我关心医疗、数据与软件交界的地方。做小而诚实的工具：从 Apple Health 数据生成一份训练诊断、几个网页实验，以及这个网站。
      </p>
      <div class="hero-actions">
        <a class="button" href="/projects/">看看作品 <span class="arrow">↗</span></a>
        <a class="button ghost" href="/cv/">查看简历</a>
        <a class="button ghost" href={'mailto:' + site.email}>写信给我</a>
      </div>
      <div class="hero-facts">
        <div><span>所在地</span><b>德国 · 海尔布隆</b></div>
        <div><span>就读</span><b>医学信息学</b></div>
        <div><span>状态</span><b>开放学生工岗位</b></div>
      </div>
    </div>
    <aside class="portrait-card">
      <img
        src="https://images.unsplash.com/profile-1728162279899-c522b6e2352a?ixlib=rb-4.1.0&crop=faces&fit=crop&w=600&h=750&q=80&auto=format"
        alt="Jiaming Luo 的肖像"
        width="600"
        height="750"
        loading="eager"
      />
      <div class="portrait-caption"><span>海尔布隆 / 49.14° N</span><span>欢迎联系</span></div>
    </aside>
  </section>

  <div class="shell">
    <div class="now-strip">
      <div class="now-item"><span class="now-dot"></span><span><b>现在</b> — 医学信息学本科，海德堡 &amp; 海尔布隆</span></div>
      <div class="now-item"><span class="now-dot"></span><span><b>在做</b> — 一个私人的训练诊断</span></div>
      <div class="now-item"><span class="now-dot"></span><span><b>在学</b> — 健康数据、界面与德语</span></div>
    </div>
  </div>

  <section class="home-section shell">
    <SectionHead index="01" title="作品" note="最近在做的三件事" />
    <div class="work-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="home-section shell">
    <SectionHead index="02" title="文章" note="过程中的记录" />
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="home-section shell">
    <SectionHead index="03" title="照片" note="一小册视觉日记" />
    <PhotoGrid photos={photos} limit={6} />
    <div class="photo-foot">
      <span>按 Unsplash 浏览量排序</span>
      <a class="button ghost" href="/photos/">全部照片 <span class="arrow">↗</span></a>
    </div>
  </section>

  <section class="shell">
    <div class="training-callout">
      <div>
        <div class="eyebrow">训练 / 每周更新</div>
        <h2>训练是数据，<br />恢复是上下文。</h2>
        <p>
          每周一次的训练诊断：训练负荷、跑步动态、睡眠、HRV，以及一条不轻易移动的个人基线。
          这里公开的是聚合后的指标，原始数据留在本地。
        </p>
        <a class="button" href={site.training}>看看这周的训练 <span class="arrow">↗</span></a>
      </div>
      <div class="training-aside">
        <div class="training-mini">
          <span>最新报告</span><b>2026 · W47</b>
          <span>数据来源</span><b>Apple Health → iCloud</b>
          <span>访问</span><b>公开摘要</b>
        </div>
        <div class="training-mini">
          <span>构建方式</span><b>Python · SVG · HTML</b>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
