---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/photos';
import { getCollection } from 'astro:content';
const entries = (await getCollection('diary', ({data}) => !data.draft)).sort((a,b) => +b.data.date - +a.data.date).slice(0,3);
const photograph = photos.find(p => p.caption === '巴黎，日落时分的铁塔') ?? photos[0];
---
<BaseLayout>
  <div class="folio shell">
    <header><h1>骆佳铭<small>Jiaming Luo</small></h1><a href="/cv/">医学信息学 · 个人履历 →</a></header>
    <figure><a href="/photos/"><img src={photograph.src} srcset={photograph.srcset} sizes="(max-width: 720px) 90vw, 65vw" alt={photograph.alt} /></a><figcaption>{photograph.caption}<a href="/photos/">摄影选集 →</a></figcaption></figure>
  </div>
  <section class="shell journal"><h2><a href="/diary/">近日手记</a></h2>{entries.map(e => <a class="post-row" href={'/diary/'+e.id+'/'}><time>{e.data.date.toISOString().slice(0,10)}</time><span>{e.data.title}</span></a>)}</section>
</BaseLayout>
<style>
.folio{display:grid;grid-template-columns:1fr 1.7fr;align-items:end;gap:4vw;padding-block:clamp(2rem,6vw,6rem)}
.folio header{padding-bottom:2rem}.folio h1{font:500 clamp(3rem,6vw,6rem)/1.12 var(--display);margin-bottom:2rem}.folio small{display:block;font:italic .49em/1.6 var(--display)}
figure{margin:0}figure img{width:100%;height:auto;max-height:70vh;object-fit:contain;object-position:left bottom}figcaption{display:flex;justify-content:space-between;margin-top:.7rem;font-size:.85rem;color:var(--muted)}
.journal{padding-bottom:5rem}.journal h2{font-family:var(--display)}time{color:var(--muted)}
@media(max-width:720px){.folio{grid-template-columns:1fr}.folio header{padding:0}.folio h1{margin-bottom:.75rem}.journal .post-row{display:grid;grid-template-columns:1fr}}
</style>
