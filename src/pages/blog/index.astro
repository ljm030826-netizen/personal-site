---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<BaseLayout title="Writing" description="Notes on health data, software, and studying in Germany.">
  <section class="page-hero shell">
    <div class="eyebrow">Writing / notes from the process</div>
    <h1>Thinking<br />out loud.</h1>
    <p class="lede">Short essays about building health-data tools, learning in public, and the small decisions that make software feel human.</p>
  </section>
  <section class="page-body shell">
    <div class="blog-list post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
