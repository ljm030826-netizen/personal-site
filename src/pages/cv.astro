---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cv } from '../data/cv';
import { site } from '../data/site';
---
<BaseLayout title="简历" description="Jiaming Luo 的简历：医学信息学学生，医院 HiWi，数据与医疗 IT。">
  <section class="cv-hero shell">
    <div>
      <div class="eyebrow">简历 / 2026.11</div>
      <h1>Jiaming<br /><em>Luo.</em></h1>
      <p class="lede">{cv.summary}</p>
      <div class="cv-actions">
        <button class="button" type="button" onclick="window.print()">打印 / 存为 PDF <span class="arrow">↗</span></button>
        <a class="button ghost" href={'mailto:' + site.email}>发邮件给我</a>
      </div>
    </div>
    <aside class="cv-side">
      {cv.personal.map((item) => (
        <div><b>{item.label}</b><br />{item.value}</div>
      ))}
      <div><b>邮箱</b><br /><a href={'mailto:' + site.email}>{site.email}</a></div>
    </aside>
  </section>

  <div class="cv-grid shell">
    <div>
      <section class="cv-section">
        <h2>教育</h2>
        <div class="timeline">
          {cv.education.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.org}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>经历</h2>
        <div class="timeline">
          {cv.experience.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.org}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>项目</h2>
        <div class="timeline">
          {cv.projects.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.role}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <aside>
      <section class="cv-section">
        <h2>技能</h2>
        {cv.skills.map((block) => (
          <div class="skill-block">
            <h3>{block.group}</h3>
            <p>{block.items.join(' · ')}</p>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>社团</h2>
        {cv.engagement.map((item) => (
          <p class="timeline-detail" style="margin-bottom:10px">{item}</p>
        ))}
      </section>

      <section class="cv-section">
        <h2>兴趣</h2>
        <div class="interests">
          {cv.interests.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <section class="cv-section">
        <h2>别处</h2>
        <div class="skill-block">
          <h3>日记</h3>
          <p><a href="/diary/">从朋友圈搬过来的长文。</a></p>
        </div>
        <div class="skill-block">
          <h3>作品</h3>
          <p><a href="/projects/">2024–2026 年做过的项目。</a></p>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
