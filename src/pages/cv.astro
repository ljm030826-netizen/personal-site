---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cv } from '../data/cv';
import { site } from '../data/site';
---
<BaseLayout title="简历" description="Jiaming Luo 的简历：医学信息学学生，医院 HiWi，数据与医疗 IT。">
  <section class="cv-hero shell">
    <div>
      <div class="eyebrow">医学信息学 · B.Sc. 在读</div>
      <h1>骆佳铭 <small>Jiaming Luo</small></h1>
      <p class="lede">{cv.summary}</p>
      <div class="cv-actions">
        <button class="button" type="button" onclick="window.print()">打印 / 存为 PDF <span class="arrow">↗</span></button>
        <a class="button ghost" href={'mailto:' + site.email}>电子邮件</a>
      </div>
    </div>
    <aside class="cv-side">
      {cv.personal.map((item) => (
        <div><b>{item.label}</b><br />{item.value}</div>
      ))}
      <div><b>邮箱</b><br /><a href={'mailto:' + site.email}>{site.email}</a></div>
    </aside>
  </section>

  <div class="cv-grid shell">
    <div>
      <section class="cv-section">
        <h2>教育背景</h2>
        <div class="timeline">
          {cv.education.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.org}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>专业经历</h2>
        <div class="timeline">
          {cv.experience.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.org}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="cv-section">
        <h2>项目</h2>
        <div class="timeline">
          {cv.projects.map((item) => (
            <div class="timeline-item">
              <div class="timeline-period">{item.period}</div>
              <div>
                <h3>{item.title}</h3>
                <div class="timeline-org">{item.role}</div>
                <p class="timeline-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <aside>
      <section class="cv-section">
        <h2>技能</h2>
        {cv.skills.map((block) => (
          <div class="skill-block">
            <h3>{block.group}</h3>
            <p>{block.items.join(' · ')}</p>
          </div>
        ))}
      </section>

      <section class="cv-section">
        <h2>社团</h2>
        {cv.engagement.map((item) => (
          <p class="timeline-detail" style="margin-bottom:10px">{item}</p>
        ))}
      </section>

      <section class="cv-section">
        <h2>兴趣</h2>
        <div class="interests">
          {cv.interests.map((item) => <span>{item}</span>)}
        </div>
      </section>


    </aside>
  </div>
</BaseLayout>

<style>.cv-hero h1{font:600 clamp(2.5rem,5vw,4rem)/1.25 var(--body);letter-spacing:0}.cv-hero small{display:block;font-size:.48em;color:var(--muted);font-weight:400}.cv-hero .lede{font:400 1rem/1.8 var(--body);max-width:30em}.cv-hero{padding-block:3rem}.timeline-period{font-variant-numeric:tabular-nums}@media print{.cv-actions{display:none}.timeline-item{break-inside:avoid}}</style>
