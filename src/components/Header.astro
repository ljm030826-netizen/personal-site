---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Home">
      <span class="brand-mark">JL</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {site.nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
      ))}
      <a class="training-link" href={site.training}>
        <span class="lock" aria-hidden="true">●</span> Training
      </a>
    </nav>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <div class="mobile-menu-panel">
        {site.nav.map((item) => (
          <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
        ))}
        <a href={site.training}>Training <span aria-hidden="true">↗</span></a>
      </div>
    </details>
  </div>
</header>
