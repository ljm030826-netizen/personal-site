---
import type { Photo } from '../data/photos';

interface Props {
  photos: Photo[];
  limit?: number;
}
const { photos, limit } = Astro.props;
const items = limit ? photos.slice(0, limit) : photos;
---
<div class="photo-grid">
  {items.map((photo) => (
    <figure class:list={['photo-item', photo.span]} style={'background-color:' + photo.color}>
      <a href={photo.href} target="_blank" rel="noopener">
        <img
          src={photo.src}
          srcset={photo.srcset}
          sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
          alt={photo.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>
        <span>{photo.caption}</span>
        <span>{photo.meta}</span>
      </figcaption>
    </figure>
  ))}
</div>
