---
interface Props {
  project: any;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { title, description, year, role, stack } = project.data;
---
<a class:list={['project-card', { compact }]} href={`/projects/${project.id}/`}>
  <div class="project-card-top">
    <span class="project-year">{year}</span>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="project-meta">
    <span>{role}</span>
    <span class="project-tags">{stack.slice(0, 3).join(' · ')}</span>
  </div>
</a>
